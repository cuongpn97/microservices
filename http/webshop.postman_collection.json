{
  "info": {
    "name": "Webshop Microservices",
    "description": "Luồng demo: đăng ký → credit → đăng nhập → giỏ hàng → checkout (Saga) → poll đơn. Chạy theo thứ tự (Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "gateway", "value": "http://localhost:8080"},
    {"key": "keyboard", "value": "11111111-1111-1111-1111-111111111111"},
    {"key": "mouse", "value": "22222222-2222-2222-2222-222222222222"},
    {"key": "laptop", "value": "44444444-4444-4444-4444-444444444444"},
    {"key": "adminEmail", "value": "admin@webshop.local"},
    {"key": "adminPassword", "value": "local-only-admin-pw"}
  ],
  "item": [
    {
      "name": "1. Register",
      "event": [
        {"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('email', 'alice-' + Date.now() + '@example.com');"]}},
        {"listen": "test", "script": {"exec": ["pm.test('201', () => pm.response.to.have.status(201));"]}}
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway}}/api/auth/register",
        "body": {"mode": "raw", "raw": "{\"email\":\"{{email}}\",\"password\":\"alice-password-1\",\"fullName\":\"Alice\"}"}
      }
    },
    {
      "name": "2. Login",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('token', pm.response.json().accessToken);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway}}/api/auth/login",
        "body": {"mode": "raw", "raw": "{\"email\":\"{{email}}\",\"password\":\"alice-password-1\"}"}
      }
    },
    {
      "name": "3. Wallet (retry until 200)",
      "event": [{"listen": "test", "script": {"exec": [
        "if (pm.response.code === 404) { setTimeout(() => {}, 1000); postman.setNextRequest('3. Wallet (retry until 200)'); }",
        "else { pm.test('initial credit', () => pm.expect(pm.response.json().availableVnd).to.eql(10000000)); }"
      ]}}],
      "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{gateway}}/api/wallet/me"}
    },
    {
      "name": "4. List products",
      "request": {"method": "GET", "url": "{{gateway}}/api/products"}
    },
    {
      "name": "5. Add keyboard x2",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway}}/api/cart/items",
        "body": {"mode": "raw", "raw": "{\"productId\":\"{{keyboard}}\",\"quantity\":2}"}
      }
    },
    {
      "name": "6. Add mouse x1",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway}}/api/cart/items",
        "body": {"mode": "raw", "raw": "{\"productId\":\"{{mouse}}\",\"quantity\":1}"}
      }
    },
    {
      "name": "7. Get cart",
      "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{gateway}}/api/cart"}
    },
    {
      "name": "8. Checkout",
      "event": [
        {"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('idemKey', 'checkout-' + Date.now());"]}},
        {"listen": "test", "script": {"exec": [
          "pm.test('202', () => pm.response.to.have.status(202));",
          "pm.collectionVariables.set('orderId', pm.response.json().orderId);"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Idempotency-Key", "value": "{{idemKey}}"}],
        "url": "{{gateway}}/api/orders/checkout"
      }
    },
    {
      "name": "9. Checkout retry (same key → same order)",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('200 replay', () => pm.response.to.have.status(200));",
        "pm.test('same order', () => pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get('orderId')));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Idempotency-Key", "value": "{{idemKey}}"}],
        "url": "{{gateway}}/api/orders/checkout"
      }
    },
    {
      "name": "10. Poll order",
      "event": [{"listen": "test", "script": {"exec": [
        "const s = pm.response.json().status;",
        "if (s === 'PENDING') { setTimeout(() => {}, 1000); postman.setNextRequest('10. Poll order'); }",
        "else { pm.test('confirmed', () => pm.expect(s).to.eql('CONFIRMED')); }"
      ]}}],
      "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{gateway}}/api/orders/{{orderId}}"}
    },
    {
      "name": "11. Wallet after capture",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('6,550,000 left', () => pm.expect(pm.response.json().balanceVnd).to.eql(6550000));"]}}],
      "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{gateway}}/api/wallet/me"}
    },
    {
      "name": "12. Checkout without token → 401",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('401', () => pm.response.to.have.status(401));"]}}],
      "request": {"method": "POST", "header": [{"key": "Idempotency-Key", "value": "anonymous-1"}], "url": "{{gateway}}/api/orders/checkout"}
    },
    {
      "name": "13. Admin login",
      "event": [{"listen": "test", "script": {"exec": ["pm.collectionVariables.set('admin', pm.response.json().accessToken);"]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway}}/api/auth/login",
        "body": {"mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"}
      }
    },
    {
      "name": "14. Admin: set stock",
      "request": {
        "method": "PUT",
        "header": [{"key": "Authorization", "value": "Bearer {{admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway}}/api/inventory/{{mouse}}",
        "body": {"mode": "raw", "raw": "{\"stockOnHand\":200}"}
      }
    },
    {
      "name": "15. Admin: saga detail (order-service:8086)",
      "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{admin}}"}], "url": "http://localhost:8086/admin/sagas/{{orderId}}"}
    }
  ]
}
