{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "vi_folding": { "type": "asciifolding", "preserve_original": true },
        "prefix_ngram": { "type": "edge_ngram", "min_gram": 2, "max_gram": 15 }
      },
      "analyzer": {
        "vi_text": {
          "tokenizer": "standard",
          "filter": ["lowercase", "vi_folding"]
        },
        "vi_prefix": {
          "tokenizer": "standard",
          "filter": ["lowercase", "vi_folding", "prefix_ngram"]
        }
      },
      "normalizer": {
        "vi_sort": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "productId":          { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "vi_text",
        "fields": {
          "prefix": { "type": "text", "analyzer": "vi_prefix", "search_analyzer": "vi_text" },
          "sort":   { "type": "keyword", "normalizer": "vi_sort" }
        }
      },
      "description":        { "type": "text", "analyzer": "vi_text" },
      "priceVnd":           { "type": "long" },
      "active":             { "type": "boolean" },
      "deleted":            { "type": "boolean" },
      "productVersion":     { "type": "long" },
      "productUpdatedAt":   { "type": "date" }
    }
  }
}
