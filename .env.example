# =====================================================================
# Biến môi trường cho docker compose (LOCAL ONLY).
#   cp .env.example .env
# Các giá trị dưới đây CHỈ dùng cho máy local. KHÔNG dùng cho môi trường thật.
# File .env đã nằm trong .gitignore — không commit secret.
# =====================================================================

# PostgreSQL superuser (chỉ dùng để chạy script khởi tạo database)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-only-postgres-pw

# Mỗi service một user/database riêng
AUTH_DB_PASSWORD=local-only-auth-db-pw
PRODUCT_DB_PASSWORD=local-only-product-db-pw
CART_DB_PASSWORD=local-only-cart-db-pw
INVENTORY_DB_PASSWORD=local-only-inventory-db-pw
PAYMENT_DB_PASSWORD=local-only-payment-db-pw
ORDER_DB_PASSWORD=local-only-order-db-pw

# RabbitMQ
RABBITMQ_USERNAME=webshop
RABBITMQ_PASSWORD=local-only-rabbit-pw

# JWT HS256 shared secret (>= 32 bytes). Production: dùng RS256/ES256 + JWKS (xem docs/design-decisions.md)
JWT_SECRET=local-only-jwt-secret-please-change-0123456789
JWT_ISSUER=webshop-auth
JWT_ACCESS_TOKEN_TTL=PT30M

# Tài khoản ADMIN khởi tạo (dùng cho thiết lập tồn kho, xem DLQ, can thiệp Saga)
ADMIN_EMAIL=admin@webshop.local
ADMIN_PASSWORD=local-only-admin-pw

# Gateway
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Saga (giá trị nhỏ giúp demo timeout nhanh hơn)
SAGA_STEP_TIMEOUT=15s
SAGA_MAX_RESERVE_ATTEMPTS=3

# Log JSON (ECS) trong container. Để trống để dùng log dạng text.
LOG_FORMAT=ecs
