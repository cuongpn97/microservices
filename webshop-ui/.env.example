# Biến môi trường cho Next.js BFF (chỉ đọc phía server, KHÔNG lộ xuống trình duyệt).
GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
CART_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
ORDER_SERVICE_URL=http://localhost:8086
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
# Chỉ dùng cho nút "Gửi message hỏng" ở trang Quản trị — lấy từ ../.env
RABBITMQ_USERNAME=webshop
RABBITMQ_PASSWORD=
# Link Swagger trên thanh điều hướng (biến NEXT_PUBLIC_* được bake vào bundle trình duyệt)
NEXT_PUBLIC_SWAGGER_URL=http://localhost:8080/swagger-ui.html
