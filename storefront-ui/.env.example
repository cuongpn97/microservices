# Biến môi trường cho Next.js BFF của storefront (chỉ đọc phía server, KHÔNG lộ xuống trình duyệt).
# Storefront chỉ nói chuyện với API Gateway — không có URL service nội bộ nào ở đây.
GATEWAY_URL=http://localhost:8080
# Link sang backoffice ở footer/trang đơn hàng (biến NEXT_PUBLIC_* được bake vào bundle trình duyệt lúc build)
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001
